‡|ÏåÿJ‚_l»l³¦·ÿÒoPo@ïômã’~jäØ¸9y3Všæ!%1øŠâÉë—ºçŞ‰}ğ˜ÇDeC7Ä¼º:Ğö¥80»>S‘wÉéJ½g¥ï@c`|Á³˜şÊL»ëû7¥µ¹[ú=CÉ‘Iü7Ô›ı^ÒäRş·ığó6ûà<Ç}H<.ÓèßKq6ÎwÚJßA÷,ôê…n…œë¾6ï«}tHá/›s›ÿ?ÂÁÄÿÊœğÎï£­1mÃœÁÔ÷§O™òÛl’ôşé?E³1ñ#HKßkº‡àİÈ/áuˆóşB¡/…Ş_cY—º8lLâxºvyo"µcõ]ï‘L²@½sxnŞ³šÑxÑO=³ÌĞëÚ†e73³=^Cóı—€7µŒ?§‘·é-Ê§Ÿùòøã]?Ğdßà§rwõğŠ0xxÆÚß"OCZÜı#ÿ%¦&ŸØ÷Š8Áƒ10îVÀpY‹3gï1®Ğ_âvEÛA¾ùxï7k␀×GÜ#ÏÙÛiøáş!•	ûsÈœ6³¶0yùdsí.øóŒ[8ÎO#sIº¢z„Ï>N(Ïx>Ô‰‡mFúòi3tÙ	oB÷<E¸ ¾Ùöä¬˜şŞöFßØ4eñO"ûz	ÏŸxVxP0A~úYWHl
ú?Í4YW.â×e{û¶qAè‰;]|M8N¼^»¿I)*`ÍYÉûnU­½ŸagåöS¯şn¿%Dşíşõ{uøı^èg&fè¦ê␀␀␀␀␀␀␀␀shader_type canvas_item;
render_mode unshaded;

uniform float icon_size = 46.0;
uniform vec4 icon_region = vec4(0.0, 0.0, 1.0, 1.0);
varying vec4 tint;

float inside_icon(vec2 uv) {
	return step(0.0, uv.x) * step(uv.x, 1.0) * step(0.0, uv.y) * step(uv.y, 1.0);
}

void vertex() {
	tint = COLOR;
	vec2 local_uv = (UV - icon_region.xy) / icon_region.zw;
	VERTEX += (local_uv * 2.0 - 1.0) * 7.0;
}

void fragment() {
	vec2 local_uv = (UV - icon_region.xy) / icon_region.zw;
	vec2 uv = (local_uv - 0.5) * (icon_size + 14.0) / icon_size + 0.5;
	vec4 art = texture(TEXTURE, icon_region.xy + clamp(uv, vec2(0.0), vec2(1.0)) * icon_region.zw);
	art.a *= inside_icon(uv);
	float rim = art.a;
	float shadow = 0.0;
	for (int i = 0; i < 8; i++) {
		float angle = float(i) * 0.785398163;
		vec2 dir = vec2(cos(angle), sin(angle));
		vec2 q = uv + dir * 1.8 / icon_size;
		float a = texture(TEXTURE, icon_region.xy + clamp(q, vec2(0.0), vec2(1.0)) * icon_region.zw).a * inside_icon(q);
		rim = max(rim, a);
		q = uv + (dir * 2.7 - vec2(1.5, 3.0)) / icon_size;
		a = texture(TEXTURE, icon_region.xy + clamp(q, vec2(0.0), vec2(1.0)) * icon_region.zw).a * inside_icon(q);
		shadow = max(shadow, a * 0.55);
	}
	float under = rim + shadow * (1.0 - rim);
	vec3 under_rgb = (vec3(0.95, 0.91, 0.82) * rim + vec3(0.08, 0.07, 0.06) * shadow * (1.0 - rim)) / max(under, 0.0001);
	float alpha = art.a + under * (1.0 - art.a);
	vec3 rgb = (art.rgb * art.a + under_rgb * under * (1.0 - art.a)) / max(alpha, 0.0001);
	COLOR = vec4(rgb, alpha) * tint;
}
